Screen {
    overflow: hidden;
}

#cli-corners {
    height: 1fr;
    width: 100%;
    border: rgb(25, 233, 188);
    overflow-y: scroll;
    scrollbar-size: 0 0;
}

#input-container {
    dock: bottom;
    height: 3;
    width: 100%;
    border: rgb(233, 87, 25);
}

#prompt-label {
    width: 3;
    height: 100%;
    content-align: center middle;
    color: rgb(233, 87, 25);
}

#user-input{
    height: 1fr;
    width: 100%;
    border: none;
}